# Bioland Head Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Configuration
NUXT_API_USER_PASS=
NUXT_API_USER=
NUXT_API_KEY=
 

# External Service Keys
NUXT_PANORAMA_KEY=
NUXT_JIRA_TOKEN=

# AWS Configuration for Translation Service
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# i18n Cache Database Configuration
I18N_DB_HOST=localhost
I18N_DB_PORT=3306
I18N_DB_USER=
I18N_DB_PASSWORD=
I18N_DB_NAME=i18n_cache
I18N_DB_CONNECTION_LIMIT=5

# Public Runtime Configuration

# multisite specific
NUXT_PUBLIC_MULTI_SITE_CODE=bsl
NUXT_PUBLIC_BASE_HOST=bsl.cbddev.xyz

# NUXT_PUBLIC_MULTI_SITE_CODE=bl2
# NUXT_PUBLIC_BASE_HOST=bl2.cbddev.xyz
# NUXT_PUBLIC_SHOW_BL1_LINK=true

# general
NUXT_PUBLIC_ENV=dev
NUXT_PUBLIC_DMSM=https://dmsm.cbddev.xyz/api
NUXT_PUBLIC_GAIA_API=https://api.cbd.int/api
NUXT_PUBLIC_IS_LOCAL_HOST=true
NUXT_PUBLIC_LOG_ALL=false
NUXT_PUBLIC_LOG_SERVER_OUT_REQUESTS=false
NUXT_LOG_API=false

# Local Development - Drupal Session Cookie
# Copy the SSESS cookie from staging to bypass localhost cookie restrictions
# Example: SSESSdbd018c8ea734dc9cc1a86733ab75a20=fe328df585b6ced6fc0d714df1acc2e0
NUXT_LOCAL_DRUPAL_SESSION=

