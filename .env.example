# Bioland Head Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Configuration
NUXT_API_USER_PASS=
NUXT_API_USER=
NUXT_API_KEY=
 

# External Service Keys
NUXT_PANORAMA_KEY=
NUXT_JIRA_TOKEN=

# AWS Configuration for Translation Service
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# i18n Cache Database Configuration
I18N_DB_HOST=localhost
I18N_DB_PORT=3306
I18N_DB_USER=
I18N_DB_PASSWORD=
I18N_DB_NAME=i18n_cache
I18N_DB_CONNECTION_LIMIT=5

# Public Runtime Configuration

# multisite specific
NUXT_PUBLIC_MULTI_SITE_CODE=bsl
NUXT_PUBLIC_BASE_HOST=bsl.cbddev.xyz

# NUXT_PUBLIC_MULTI_SITE_CODE=bl2
# NUXT_PUBLIC_BASE_HOST=bl2.cbddev.xyz
# NUXT_PUBLIC_SHOW_BL1_LINK=true

# general
NUXT_PUBLIC_ENV=dev
NUXT_PUBLIC_DMSM=https://dmsm.cbddev.xyz/api
NUXT_PUBLIC_GAIA_API=https://api.cbd.int/api
NUXT_PUBLIC_IS_LOCAL_HOST=true
NUXT_PUBLIC_LOG_ALL=false
NUXT_PUBLIC_LOG_SERVER_OUT_REQUESTS=false
NUXT_LOG_API=false

# Local Development - Drupal Session Cookie
# Copy the SSESS cookie from staging to bypass localhost cookie restrictions
# Format: <cookie-name>=<cookie-value> — set locally, never commit
NUXT_LOCAL_DRUPAL_SESSION=

# E2E Test Users
# Create these users in Drupal admin with the roles listed below
# Set all values locally, never commit them
NUXT_E2E_LOCAL_URL=http://e2e.localhost:3330
# set locally, never commit
NUXT_E2E_DRUPAL_URL=
# set locally, never commit
NUXT_E2E_USER_PASSWORD=

# User accounts by role — set locally, never commit
NUXT_E2E_USER_SCBD_STAFF=
NUXT_E2E_USER_SITE_MANAGER=
NUXT_E2E_USER_CONTENT_MANAGER=
NUXT_E2E_USER_CONTRIBUTOR=
NUXT_E2E_USER_AUTHENTICATED=
# Anonymous role requires no credentials

